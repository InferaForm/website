# Email Configuration for Contact Form (Resend)
# ==============================================
# Copy this file to .env.local and fill in your actual values.

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender (display name + email)
# For testing without a domain: "Inferaform <onboarding@resend.dev>"
RESEND_FROM_EMAIL="Inferaform <hello@inferaform.com>"

# Where contact form submissions should be sent
CONTACT_EMAIL_TO=inferaform@gmail.com
